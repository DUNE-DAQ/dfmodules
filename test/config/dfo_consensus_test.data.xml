<!--
  DFO_A:
    Inputs:  token_a (TriggerDecisionToken from TRBs and from DFO_B)
             trigdec_in_a (TriggerDecision from MLT)
    Outputs: triginh_a (TriggerInhibit to MLT)
             trigdec_trb_a (TriggerDecision to TRBApp_A)
             peer_to_b (TriggerDecisionToken peer announcement to DFO_B)
-->
<obj class="DFOModule" id="dfo_a">
 <rel name="inputs">
  <ref class="NetworkConnection" id="token_a"/>
  <ref class="NetworkConnection" id="trigdec_in_a"/>
 </rel>
 <rel name="outputs">
  <ref class="NetworkConnection" id="triginh_a"/>
  <ref class="NetworkConnection" id="trigdec_trb_a"/>
  <ref class="NetworkConnection" id="peer_to_b"/>
 </rel>
 <rel name="configuration" class="DFOConf" id="dfo_conf"/>
</obj>

<!--
  DFO_B:
    Inputs:  token_b (TriggerDecisionToken from TRBs and from DFO_A)
             trigdec_in_b (TriggerDecision from MLT)
    Outputs: triginh_b (TriggerInhibit to MLT)
             trigdec_trb_b (TriggerDecision to TRBApp_B)
             peer_to_a (TriggerDecisionToken peer announcement to DFO_A)
-->
<obj class="DFOModule" id="dfo_b">
 <rel name="inputs">
  <ref class="NetworkConnection" id="token_b"/>
  <ref class="NetworkConnection" id="trigdec_in_b"/>
 </rel>
 <rel name="outputs">
  <ref class="NetworkConnection" id="triginh_b"/>
  <ref class="NetworkConnection" id="trigdec_trb_b"/>
  <ref class="NetworkConnection" id="peer_to_a"/>
 </rel>
 <rel name="configuration" class="DFOConf" id="dfo_conf"/>
</obj>

